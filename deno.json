{
	"name": "@marianmeres/page-fetcher",
	"version": "0.4.0",
	"exports": {
		".": "./src/mod.ts",
		"./adapters": "./src/adapters.ts",
		"./cache": "./src/cache.ts"
	},
	"publish": {
		"exclude": [
			".*",
			"tests/**",
			"example/**",
			"scripts/gen-example-*.ts"
		]
	},
	"tasks": {
		"test": "deno test --allow-net=127.0.0.1 --ignore=tests/browser,tests/mcp tests/",
		"test:watch": "deno test --watch --allow-net=127.0.0.1 --ignore=tests/browser,tests/mcp tests/",
		"test:browser": "BROWSER_TESTS=1 deno test -A tests/browser/",
		"test:browser:puppeteer": "BROWSER_TESTS=1 BROWSER_DRIVER=puppeteer deno test -A tests/browser/",
		"test:mcp": "deno test -A tests/mcp/",
		"doc:lint": "deno doc --lint src/mod.ts src/adapters.ts src/cache.ts && deno check --doc src/",
		"example": "deno run -A example/server.ts",
		"example:version": "deno run -A scripts/gen-example-version.ts",
		"example:theme": "deno run -A scripts/gen-example-theme.ts",
		"example:build": "deno task example:version && deno run -A jsr:@marianmeres/deno-build --root example/src --entry main.ts --outdir example/dist --strict --minify",
		"example:dev": "deno task example:version && deno run -A jsr:@marianmeres/deno-build --root example/src --entry main.ts --outdir example/dist --watch --watch-dir example/src",
		"npm:build": "deno run -A scripts/build-npm.ts",
		"npm:publish": "deno run -A scripts/build-npm.ts && cd ./.npm-dist && npm publish --access=public",
		"release": "deno run -A jsr:@marianmeres/release",
		"publish": "deno publish && deno task npm:publish",
		"rp": "deno task release -y && deno task publish",
		"rpm": "deno task release minor -y && deno task publish"
	},
	"imports": {
		"@marianmeres/page-fetcher": "./src/mod.ts",
		"@marianmeres/page-fetcher/adapters": "./src/adapters.ts",
		"@marianmeres/page-fetcher/cache": "./src/cache.ts",
		"@marianmeres/clog": "jsr:@marianmeres/clog@^3.21.0",
		"@marianmeres/design-tokens": "jsr:@marianmeres/design-tokens@^1.17.0",
		"@marianmeres/vanilla": "jsr:@marianmeres/vanilla@^1.8.0",
		"@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1.16.0",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/fs": "jsr:@std/fs@^1.0.24",
		"@std/path": "jsr:@std/path@^1.1.6",
		"@std/testing": "jsr:@std/testing@^1.0.18"
	},
	"exclude": [
		"example/dist"
	],
	"lint": {
		"exclude": [
			"mcp.ts"
		]
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"proseWrap": "preserve"
	}
}
